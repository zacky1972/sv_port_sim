#!/usr/bin/env elixir

defmodule SvPortSimPortErrorResponseFixture do
  @version 1

  def main(_argv) do
    with {:ok, input} <- :file.open(~c'/dev/stdin', [:read, :raw, :binary]),
         {:ok, output} <- :file.open(~c'/dev/stdout', [:write, :raw, :binary]) do
      loop(%{input: input, output: output})
    else
      {:error, _reason} -> System.halt(2)
    end
  end

  defp loop(state) do
    case read_frame(state.input) do
      :eof ->
        :ok

      {:ok, payload} ->
        payload
        |> JSON.decode!()
        |> handle_request(state)

      {:error, _reason} ->
        System.halt(2)
    end
  end

  defp read_frame(input) do
    with {:ok, <<length::32>>} <- read_exact(input, 4),
         {:ok, payload} <- read_exact(input, length) do
      {:ok, payload}
    else
      :eof -> :eof
      {:error, _reason} = error -> error
    end
  end

  defp read_exact(input, byte_count), do: read_exact(input, byte_count, [])
 
  defp read_exact(_input, 0, chunks) do
    {:ok, chunks |> Enum.reverse() |> IO.iodata_to_binary()}
  end

  defp read_exact(input, byte_count, chunks) when byte_count > 0 do
    case :file.read(input, byte_count) do
      {:ok, chunk} when byte_size(chunk) > 0 ->
        read_exact(input, byte_count - byte_size(chunk), [chunk | chunks])

      {:ok, <<>>} ->
        {:error, :empty_read}

      :eof when chunks == [] ->
        :eof

      :eof ->
        {:error, {:short_read, byte_count}}

      {:error, reason} ->
        {:error, reason}
    end
  end

  defp handle_request(%{"op" => "peek", "body" => %{"signal" => "missing"}} = request, state) do
    body = %{
      "code" => "invalid_signal",
      "message" => "unknown signal",
      "details" => %{"signal" => "missing"},
      "fatal" => false
    }

    write_response(state.output, request, "error", body)
    loop(state)
  end

  defp handle_request(%{"op" => "peek", "body" => %{"signal" => signal}} = request, state) do
    body = %{
      "signal" => signal,
      "value" => %{"bits" => "0", "width" => 1}
    }

    write_response(state.output, request, "response", body)
    loop(state)
  end

  defp handle_request(%{"op" => "stop"} = request, state) do
    write_response(state.output, request, "response", %{"status" => "closing"})
  end

  defp handle_request(%{} = request, state) do
    body = %{
      "code" => "invalid_request",
      "message" => "unsupported fixture request",
      "details" => %{"op" => Map.get(request, "op")},
      "fatal" => false
    }

    write_response(state.output, request, "error", body)
    loop(state)
  end

  defp write_response(output, request, kind, body) do
    response = %{
      "v" => @version,
      "id" => request["id"],
      "kind" => kind,
      "op" => request["op"],
      "body" => body
    }

    payload = JSON.encode!(response)
    :ok = :file.write(output, [<<byte_size(payload)::32>>, payload])
  end
end

SvPortSimPortErrorResponseFixture.main(System.argv())
